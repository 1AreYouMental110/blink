local function StepReplication()
    ProfileBegin("Blink.Flush.Client")
    FlushBits()
    if SendCursor <= 0 then
        ProfileEnd()
        return
    end
    if not RuntimeSupport.ShouldFlush("Server", "Reliable", SendCursor, "Gameplay") then
        ProfileEnd()
        return
    end

    local Buffer = buffer.create(SendCursor)
    buffer.copy(Buffer, 0, SendBuffer, 0, SendCursor)
    if RuntimeConfig.MaxReliablePacketBytes > 0 and SendCursor > RuntimeConfig.MaxReliablePacketBytes then
        DropPacket("Client", "Reliable", "MaxPacketBytes", SendCursor)
    else
        for _, Fragment in RuntimeSupport.FragmentReliablePacket("Server", Buffer, InstancePayload(SendInstances)) do
            Reliable:FireServer(Fragment.Buffer, Fragment.Instances)
            TrackSend("Reliable", buffer.len(Fragment.Buffer), nil)
        end
        RuntimeSupport.RecordFlush("Server", "Reliable", SendCursor)
    end

    SendSize = 64
    SendCursor = 0
    SendOffset = 0
    SendBuffer = AcquireBuffer(64)
    table.clear(SendInstances)
    SendBitByte = 0
    SendBitCount = 0
    SendStringIds = {}
    NextSendStringId = 1
    ProfileEnd()
end
RunService.Heartbeat:Connect(StepReplication)
local function ProcessReliablePacket(Buffer: buffer, Instances: {Instance}?)
	ProfileBegin("Blink.Decode.Reliable")
	local Size = ValidateIncoming("Server", "Reliable", Buffer, Instances)
	if Size == nil then
		ProfileEnd()
		return
	end
	local ReassembledBuffer, ReassembledInstances, FragmentReady = RuntimeSupport.TryReassembleReliableFragment("Server", Buffer, Instances)
	if not FragmentReady then
		ProfileEnd()
		return
	end
	Buffer = ReassembledBuffer :: buffer
	Instances = ReassembledInstances
	Size = buffer.len(Buffer)
	RecieveSize = Size
	RecieveInstances = Instances or {}
	RecieveCursor = 0
	RecieveBuffer = Buffer
	RecieveInstanceCursor = 0
	RecieveBitByte = 0
	RecieveBitCount = 0
	RecieveStrings = {}
	NextRecieveStringId = 1
	while (RecieveCursor < Size) do
		local FrameSuccess, Index = pcall(BeginReadMessage, Size)
		if not FrameSuccess then DropPacket("Server", "Reliable", "MalformedPacket", Size) RecoverMessage() continue end
		if Index == nil then continue end
		if Index == CAPABILITY_HANDSHAKE_INDEX then
			RuntimeSupport.ReadCapabilityHandshake("Server", "Reliable", Size)
			EndReadMessage()
			continue
		end
		if Index == PREDICTION_ACK_INDEX then
			local AckSuccess, AckError = pcall(ReadPredictionAckPayload)
			if not AckSuccess then DropPacket("Server", "Reliable", "MalformedPacket", Size) RunHooks("Error", { Name = "$predictionAck", Source = "Server", Channel = "Reliable", Error = AckError }) RecoverMessage() continue end
			EndReadMessage()
			continue
		end
		if Index == 0 then
			local EventStart = RecieveCursor
			if Size > 16384 then DropPacket("Server", "Reliable", "MaxPacketBytes", Size) RecoverMessage() continue end
			if not CheckRateLimit("Server", "LegacyS2C_UselessStuff_EditSignText", 60, 120) then RecoverMessage() continue end
			if not RunHooks("BeforeReceive", { Name = "LegacyS2C_UselessStuff_EditSignText", Source = "Server", Channel = "Reliable", Size = Size }) then DropPacket("Server", "Reliable", "MiddlewareRejected", Size) RecoverMessage() continue end
			if not CheckPolicy("Server", "LegacyS2C_UselessStuff_EditSignText", "Reliable", nil, nil, { Risk = "Inventory", CooldownSeconds = 0, MaxDistance = 0, RequireOwnership = false, RequireTeam = nil, RequireZone = nil, RequireMatch = nil, RequireInventoryOwnership = false, RequireCharacterState = nil, RequireObjectHandle = false, RequireServerKnownId = false, Idempotency = false }, Size) then RecoverMessage() continue end
			local Success, Value = pcall(SerdesFunctions.ReadEVENT_LegacyS2C_UselessStuff_EditSignText)
			if Success ~= true then
				DropPacket("Server", "Reliable", "MalformedPacket", Size)
				RunHooks("Error", { Name = "LegacyS2C_UselessStuff_EditSignText", Source = "Server", Channel = "Reliable", Error = Value })
				RecoverMessage() continue
			end
			if not RuntimeSupport.ValidateDecodedPayload("LegacyS2C_UselessStuff_EditSignText", "Server", "Reliable", table.pack(Value), Size) then RecoverMessage() continue end
			TrackEventReceive("LegacyS2C_UselessStuff_EditSignText", "Reliable", RecieveCursor - EventStart, "Server", table.pack(Value))
			if #Events.Reliable[0] > 0 then
				for _, Listener in Events.Reliable[0] do
					task.spawn(Listener, Value)
				end
			else
				if #Queue.Reliable[0] >= 256 then
					DropPacket("Server", "Reliable", "QueueFull", Size)
					RecoverMessage() continue
				else
					table.insert(Queue.Reliable[0], {Value} :: {any})
				end
			end
		elseif Index == 1 then
			local EventStart = RecieveCursor
			if Size > 16384 then DropPacket("Server", "Reliable", "MaxPacketBytes", Size) RecoverMessage() continue end
			if not CheckRateLimit("Server", "LegacyS2C_UselessStuff_SprayEvent", 60, 120) then RecoverMessage() continue end
			if not RunHooks("BeforeReceive", { Name = "LegacyS2C_UselessStuff_SprayEvent", Source = "Server", Channel = "Reliable", Size = Size }) then DropPacket("Server", "Reliable", "MiddlewareRejected", Size) RecoverMessage() continue end
			if not CheckPolicy("Server", "LegacyS2C_UselessStuff_SprayEvent", "Reliable", nil, nil, { Risk = "Inventory", CooldownSeconds = 0, MaxDistance = 0, RequireOwnership = false, RequireTeam = nil, RequireZone = nil, RequireMatch = nil, RequireInventoryOwnership = false, RequireCharacterState = nil, RequireObjectHandle = false, RequireServerKnownId = false, Idempotency = false }, Size) then RecoverMessage() continue end
			local Success, Value = pcall(SerdesFunctions.ReadEVENT_LegacyS2C_UselessStuff_SprayEvent)
			if Success ~= true then
				DropPacket("Server", "Reliable", "MalformedPacket", Size)
				RunHooks("Error", { Name = "LegacyS2C_UselessStuff_SprayEvent", Source = "Server", Channel = "Reliable", Error = Value })
				RecoverMessage() continue
			end
			if not RuntimeSupport.ValidateDecodedPayload("LegacyS2C_UselessStuff_SprayEvent", "Server", "Reliable", table.pack(Value), Size) then RecoverMessage() continue end
			TrackEventReceive("LegacyS2C_UselessStuff_SprayEvent", "Reliable", RecieveCursor - EventStart, "Server", table.pack(Value))
			if #Events.Reliable[1] > 0 then
				for _, Listener in Events.Reliable[1] do
					task.spawn(Listener, Value)
				end
			else
				if #Queue.Reliable[1] >= 256 then
					DropPacket("Server", "Reliable", "QueueFull", Size)
					RecoverMessage() continue
				else
					table.insert(Queue.Reliable[1], {Value} :: {any})
				end
			end
		end
		EndReadMessage()
		ProfileEnd()
	end
end
local function ProcessUnreliablePacket(Buffer: buffer, Instances: {Instance}?)
	ProfileBegin("Blink.Decode.Unreliable")
	local Size = ValidateIncoming("Server", "Unreliable", Buffer, Instances)
	if Size == nil then
		ProfileEnd()
		return
	end
	RecieveCursor = 0
	RecieveBuffer = Buffer
	RecieveInstanceCursor = 0
	RecieveBitByte = 0
	RecieveBitCount = 0
	RecieveStrings = {}
	NextRecieveStringId = 1
	while (RecieveCursor < Size) do
		local FrameSuccess, Index = pcall(BeginReadMessage, Size)
		if not FrameSuccess then DropPacket("Server", "Unreliable", "MalformedPacket", Size) RecoverMessage() continue end
		if Index == nil then continue end
		if Index == CAPABILITY_HANDSHAKE_INDEX then
			RuntimeSupport.ReadCapabilityHandshake("Server", "Unreliable", Size)
			EndReadMessage()
