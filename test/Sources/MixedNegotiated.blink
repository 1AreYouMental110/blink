option Casing = Pascal
option ClientOutput = "../../Network/MixedNegotiated/Client.luau"
option ServerOutput = "../../Network/MixedNegotiated/Server.luau"
option ManualReplication = true
option RemoteScope = "MIXED"
option ProtocolVersion = 2
option Version = 2
option MinimumSchemaVersion = 1
option ProtocolMode = Negotiated
option AcceptProtocolVersion1 = true
option EnableProtocolHandshake = true
option RateLimitPerSecond = 0

event PingServer {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: u8
}

event PingClient {
    From: Client,
    Type: Reliable,
    Call: SingleSync,
    Data: u8
}
