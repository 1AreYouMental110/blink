option Casing = Pascal
option ClientOutput = "../../Network/MixedLegacy/Client.luau"
option ServerOutput = "../../Network/MixedLegacy/Server.luau"
option ManualReplication = true
option RemoteScope = "MIXED"
option ProtocolVersion = 1
option ProtocolMode = Legacy
option EnableProtocolHandshake = false
option RateLimitPerSecond = 0

event PingServer {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: u8
}

event PingClient {
    From: Client,
    Type: Reliable,
    Call: SingleSync,
    Data: u8
}
